{
  "name": "@chubbyclaw/dsh-acp-full",
  "version": "0.2.1-alpha.1",
  "description": "ChubbyClaw fork of @deepseek-ai/dsh-acp: reports AIR subagent and async-task background work over ACP.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chubbyclaw-com/dsh-acp-full.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "profile"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "chubbyclaw": {
    "dshRuntimeVersion": "0.2.1-alpha.1"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-token-meter": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-token-meter": {
      "optional": true
    }
  }
}
