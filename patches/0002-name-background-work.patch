   type AsyncTaskStopParams,
 } from './background-tasks.ts'
@@ -196,19 +197,20 @@ export function apply(ctx: Context, config: AcpConfig): void {
   // bridge session whose badge it belongs to.
   const subagentChildren = new Map<SessionId, SessionId>()
 
-  ctx.on('session/created', (session) => {
-    const parent = session.header.parentSession
-    if (parent === undefined) return
-    const record = sessions.get(parent)
-    if (record === undefined) return
-    subagentChildren.set(session.id, parent)
+  // The parent's catalog entry is the first fact that names a child: it is
+  // appended once per in-process child, before the run starts, and carries the
+  // delegating call's `description` as its label.
+  ctx.on('session/event', (session, event) => {
+    if (event.type !== 'subagent/catalog') return
+    const record = sessions.get(session.header.id)
+    if (record?.ownsSession(session) !== true) return
+    const { childId, label } = event.data
+    subagentChildren.set(childId, session.header.id)
     if (!subagentNotifications) return
     record.enqueueBackgroundWork({
       sessionUpdate: 'subagent_spawned',
-      subagentSessionId: session.id,
-      // The harness subagent lifecycle carries no name or task at creation
-      // time; the kind is the only honest label.
-      name: 'subagent',
+      subagentSessionId: childId,
+      name: label || 'subagent',
       task: '',
       capabilities: {},
     })
@@ -227,6 +229,28 @@ export function apply(ctx: Context, config: AcpConfig): void {
     })
   })
 
+  // A shell job carries only its command line as label; the model's
+  // human-readable `description` lives on the call that started it. Calls are
+  // held from their tool/call to their tool/result, so a job registered in
+  // between is matched by owner and exact command.
+  const shellCalls = new Map<string, { readonly owner: string; readonly command: string; readonly description: string }>()
+  ctx.on('session/event', (session, event) => {
+    if (event.type === 'tool/call') {
+      const args = shellCallArgs(event.data.arguments)
+      if (args !== undefined) shellCalls.set(event.data.callId, { owner: session.header.id, ...args })
+    } else if (event.type === 'tool/result') {
+      shellCalls.delete(event.data.message.toolCallId)
+    }
+  })
+  const takeShellDescription = (owner: string, command: string): string | undefined => {
+    for (const [callId, call] of shellCalls) {
+      if (call.owner !== owner || call.command !== command) continue
+      shellCalls.delete(callId)
+      return call.description
+    }
+    return undefined
+  }
+
   // The job registry is optional: a composition without background execution
   // still loads this bridge. The read-only surface below is all we consume.
   const jobs = ctx.get('jobs') as BackgroundJobRegistry | undefined
@@ -242,18 +266,22 @@ export function apply(ctx: Context, config: AcpConfig): void {
     // paired job as well would double the badge.
     if (job.kind === 'subagent' || !asyncTaskNotifications) return
     switch (event.type) {
-      case 'registered':
+      case 'registered': {
         reportedAsyncTasks.add(job.id)
+        const described = takeShellDescription(owner, job.label)
         record.enqueueBackgroundWork({
           sessionUpdate: 'async_task_spawned',
           asyncTaskId: job.id,
-          name: job.label,
+          // Lead with what the model said it is doing; the command line moves
+          // to the description so it stays visible.
+          name: described || job.label,
           taskType: job.kind,
-          description: job.progress ?? '',
+          description: job.progress ?? (described ? job.label : ''),
           showInTranscript: false,
           canStop: true,
         })
         return
+      }
       case 'progress':
         if (!reportedAsyncTasks.has(job.id)) return
         record.enqueueBackgroundWork({
