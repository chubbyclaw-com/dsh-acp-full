@@ -111,17 +124,39 @@ describe('background work reporting over the bridge', () => {
     return sessionId
   }
 
+  /** The bridge-owned session a test appends harness facts to. */
+  const bridgeSession = (sessionId: string) => harness!.ctx.agents.get(SessionId(sessionId))!.session
+
+  /** Append the parent-side catalog entry the subagent manager writes for one child. */
+  function catalogChild(sessionId: string, childId: string, label?: string): void {
+    bridgeSession(sessionId).append('subagent/catalog', {
+      version: 1,
+      childId: SessionId(childId),
+      childCreatedAt: 0,
+      mode: 'one-shot',
+      ...label === undefined ? {} : { label },
+    })
+  }
+
+  /** Append one committed tool call on the bridge session. */
+  function toolCall(sessionId: string, callId: string, args: Record<string, unknown>): void {
+    const session = bridgeSession(sessionId)
+    session.append('turn/start', { turn: 1 })
+    session.append('step/start', { turn: 1, step: 1 })
+    session.append('tool/call', { turn: 1, step: 1, callId: ToolCallId(callId), name: 'bash', arguments: JSON.stringify(args) })
+  }
+
