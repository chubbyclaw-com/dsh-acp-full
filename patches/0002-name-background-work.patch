 3 files changed, 136 insertions(+), 21 deletions(-)

diff --git a/packages/acp/acp/src/background-tasks.ts b/packages/acp/acp/src/background-tasks.ts
index 512bf57..3e51e6d 100644
--- a/packages/acp/acp/src/background-tasks.ts
+++ b/packages/acp/acp/src/background-tasks.ts
@@ -153,3 +153,22 @@ function asRecord(value: unknown): Record<string, unknown> {
     ? value as Record<string, unknown>
     : {}
 }
+
+/**
+ * Read the shell-call shape every shell tool shares: a command line plus the
+ * model's display description. Anything else is not a shell call.
+ * @param argumentsJson - the committed tool-call arguments.
+ * @returns the command and description, or undefined.
+ */
+export function shellCallArgs(argumentsJson: string): { command: string; description: string } | undefined {
+  let value: unknown
+  try {
+    value = JSON.parse(argumentsJson)
+  } catch {
+    return undefined
+  }
+  if (typeof value !== 'object' || value === null) return undefined
+  const { command, description } = value as Record<string, unknown>
+  if (typeof command !== 'string' || typeof description !== 'string' || description.trim() === '') return undefined
+  return { command, description: description.trim() }
+}
