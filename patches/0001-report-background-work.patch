+/** Read-only projection of one background job, as the registry hands it out. */
+interface BackgroundJobView {
+  readonly id: string
+  readonly kind: string
+  readonly label: string
+  readonly owner?: string
+  readonly status: string
+  readonly progress?: string
+}
+
+/** One job-registry lifecycle event; only the fields this bridge reads. */
+type BackgroundJobEvent =
+  | { readonly type: 'registered' | 'progress' | 'stopping' | 'removed'; readonly job: BackgroundJobView }
+  | { readonly type: 'settled'; readonly job: BackgroundJobView }
+  | { readonly type: 'output'; readonly id: string; readonly owner?: string }
+
+/** The slice of `ctx.jobs` this bridge consumes, kept structural to avoid a hard dependency. */
+interface BackgroundJobRegistry {
+  readonly events: {
+    subscribe(
+      filter: { owners: 'all' },
+      listener: (event: BackgroundJobEvent) => void,
+    ): () => void
+  }
+  kill(id: string, caller?: string, reason?: string): 'requested' | 'already-finished'
+}
+
 export const name = 'acp'
 /** Core services required by the standard automation controls. */
 export const inject = ['agents', 'llm', 'sessionPersistence', 'sessions']
@@ -149,6 +186,96 @@ export function apply(ctx: Context, config: AcpConfig): void {
     for (const record of sessions.values()) record.topologyChanged()
   })
 
+  // ── Background work (draft AIR extension) ────────────────────────────────
+  //
+  // Subagents and detached jobs go only to a client that negotiated the
+  // matching capability in initialize; the two flags are set there.
+  let subagentNotifications = false
+  let asyncTaskNotifications = false
+  // Child session → delegating session, so one subagent/end can address the
+  // bridge session whose badge it belongs to.
+  const subagentChildren = new Map<SessionId, SessionId>()
+
+  ctx.on('session/created', (session) => {
+    const parent = session.header.parentSession
+    if (parent === undefined) return
+    const record = sessions.get(parent)
+    if (record === undefined) return
+    subagentChildren.set(session.id, parent)
+    if (!subagentNotifications) return
+    record.enqueueBackgroundWork({
+      sessionUpdate: 'subagent_spawned',
+      subagentSessionId: session.id,
+      // The harness subagent lifecycle carries no name or task at creation
+      // time; the kind is the only honest label.
+      name: 'subagent',
+      task: '',
+      capabilities: {},
+    })
+  })
+
+  ctx.on('subagent/end', (info: SubagentRunEndInfo) => {
+    const parent = subagentChildren.get(info.id)
+    if (parent === undefined) return
+    subagentChildren.delete(info.id)
+    const record = sessions.get(parent)
+    if (record === undefined || !subagentNotifications) return
+    record.enqueueBackgroundWork({
+      sessionUpdate: 'subagent_state_update',
+      subagentSessionId: info.id,
+      state: subagentStateOf(info.stopReason),
+    })
+  })
+
+  // The job registry is optional: a composition without background execution
+  // still loads this bridge. The read-only surface below is all we consume.
+  const jobs = ctx.get('jobs') as BackgroundJobRegistry | undefined
+  const reportedAsyncTasks = new Set<string>()
+  jobs?.events.subscribe({ owners: 'all' }, (event) => {
+    if (event.type === 'output') return
+    const { job } = event
+    const owner = job.owner
+    if (owner === undefined) return
+    const record = sessions.get(owner as SessionId)
+    if (record === undefined) return
+    // Background subagents report through their lifecycle above; counting the
+    // paired job as well would double the badge.
+    if (job.kind === 'subagent' || !asyncTaskNotifications) return
+    switch (event.type) {
+      case 'registered':
+        reportedAsyncTasks.add(job.id)
+        record.enqueueBackgroundWork({
+          sessionUpdate: 'async_task_spawned',
+          asyncTaskId: job.id,
+          name: job.label,
+          taskType: job.kind,
+          description: job.progress ?? '',
+          showInTranscript: false,
+          canStop: true,
+        })
+        return
+      case 'progress':
+        if (!reportedAsyncTasks.has(job.id)) return
+        record.enqueueBackgroundWork({
+          sessionUpdate: 'async_task_progress',
+          asyncTaskId: job.id,
+          ...(job.progress === undefined ? {} : { description: job.progress }),
+        })
+        return
+      case 'settled':
+      case 'removed':
+        if (!reportedAsyncTasks.delete(job.id)) return
+        record.enqueueBackgroundWork({
+          sessionUpdate: 'async_task_state_update',
+          asyncTaskId: job.id,
+          state: asyncTaskStateOf(job.status),
+        })
+        return
+      default:
+        return
+    }
+  })
+
   // Permission requests are a machine policy channel for ACP clients such as
   // dsh-subagent-acp. The bridge offers one-shot choices only and never infers a
   // durable grant from an unknown client response.
