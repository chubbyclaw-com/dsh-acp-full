+    // Draft AIR extension (agent-client-protocol#1992): stop one detached job.
+    // The wire method is the one clients already call; settlement, not this
+    // call, retires the item from the client's list.
+    .onRequest(
+      '_session/async_task/stop',
+      (params: unknown): AsyncTaskStopParams => params as AsyncTaskStopParams,
+      ({ params }) => {
+        const sessionId = typeof params.sessionId === 'string' ? params.sessionId : ''
+        const taskId = typeof params.asyncTaskId === 'string' ? params.asyncTaskId : ''
+        if (sessions.get(sessionId as SessionId) === undefined) {
+          throw invalidParams(`unknown session: ${sessionId}`)
